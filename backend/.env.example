# Dev defaults. Production overrides live in the Coolify UI (not committed):
#   EMBEDDINGS_ENABLED=false
#   LOG_LEVEL=INFO
#   PROMPT_STORE_CACHE_PATH=data/prompt_cache.json   (resolves to /srv/data in-container)
# Build-time: pass WITH_EMBEDDINGS=true in Coolify build args to install gensim+GloVe.

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
LOG_LEVEL=INFO

DEFAULT_DIFFICULTY=1.0
CHOICE_TARGET_PCT=0.30
OPENING_REVEAL=3

EMBEDDINGS_ENABLED=true
EMBEDDINGS_MODEL=glove-wiki-gigaword-100
EMBEDDINGS_POOL_SIZE=5000
EMBEDDINGS_TOP_K=40

ROUND_POOL_ENABLED=true
ROUND_POOL_SIZE=3
ROUND_POOL_IDLE_SLEEP=0.5
ROUND_POOL_ERROR_SLEEP=5.0

PROMPT_GENERATION_ENABLED=true
PROMPT_GENERATION_TEMPERATURE=0.95
PROMPT_GENERATION_TOP_P=0.95
PROMPT_GENERATION_BATCH_SIZE=5
PROMPT_STORE_SIZE=100
PROMPT_STORE_IDLE_SLEEP=2.0
PROMPT_STORE_ERROR_SLEEP=10.0
PROMPT_STORE_CACHE_PATH=data/prompt_cache.json
PROMPT_STORE_PREFER_GENERATED_AT=20
PROMPT_MIN_WORDS=4
PROMPT_MAX_WORDS=20
